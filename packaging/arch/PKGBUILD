# Local-checkout package: run makepkg from packaging/arch/.
pkgname=tuikanban
pkgver=0.1.0
pkgrel=1
pkgdesc='A local-first terminal kanban board and scriptable CLI'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
# No release URL is configured yet; prepare() snapshots the local checkout.
source=()
sha256sums=()

prepare() {
  local checkout="$startdir/../.."
  local project="$srcdir/$pkgname-$pkgver"
  mkdir -p "$project"
  cp "$checkout"/{Cargo.toml,Cargo.lock,LICENSE,README.md} "$project/"
  cp -a "$checkout/src" "$checkout/tests" "$project/"
  cd "$project"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --frozen

  mkdir -p completions
  "$CARGO_TARGET_DIR/release/kanban" completions bash > completions/kanban
  "$CARGO_TARGET_DIR/release/kanban" completions zsh > completions/_kanban
  "$CARGO_TARGET_DIR/release/kanban" completions fish > completions/kanban.fish
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/kanban" "$pkgdir/usr/bin/kanban"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 completions/kanban "$pkgdir/usr/share/bash-completion/completions/kanban"
  install -Dm644 completions/_kanban "$pkgdir/usr/share/zsh/site-functions/_kanban"
  install -Dm644 completions/kanban.fish "$pkgdir/usr/share/fish/vendor_completions.d/kanban.fish"
}
